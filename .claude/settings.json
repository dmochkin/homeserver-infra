{
  "permissions": {
    "deny": [
      "Read(keys.txt)",
      "Read(*.agekey)",
      "Read(*.dec.yaml)",
      "Read(*.decrypted.*)",
      "Read(k3s.yaml)",
      "Read(kubeconfig)",
      "Read(*.kubeconfig)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(*.key)",
      "Read(id_rsa)",
      "Read(id_ecdsa)",
      "Read(id_ed25519)",
      "Read(~/.config/sops/**)",
      "Read(~/Library/Application Support/sops/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.cloudflared/**)",
      "Read(//etc/rancher/k3s/**)",
      "Bash(sops decrypt *)",
      "Bash(sops -d *)",
      "Bash(sops --decrypt *)"
    ]
  }
}
