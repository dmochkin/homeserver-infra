#!/bin/sh
# Scan staged changes for secrets before every commit.
set -e

# gitleaks v8.30.1, pinned by digest so the image cannot change without a commit here.
# Keep in sync with .githooks/pre-push.
GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"

if ! command -v docker >/dev/null 2>&1; then
  echo "pre-commit: docker not found. Install Docker, or add its folder to PATH and restart this app." >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "pre-commit: Docker is not running. Start Docker Desktop and commit again." >&2
  exit 1
fi

docker run --rm -v "$(pwd):/repo" -w /repo "$GITLEAKS_IMAGE" \
  git --pre-commit --staged --redact --no-banner /repo
