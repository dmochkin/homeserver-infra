# Managed by Ansible (roles/hello_world). Deployed by k3s from its manifests folder.
# A static page at status.<domain> that proves the path Cloudflare -> tunnel -> Traefik -> app works.
apiVersion: v1
kind: Namespace
metadata:
  name: status
---
apiVersion: v1
kind: LimitRange
metadata:
  name: default-limits
  namespace: status
spec:
  limits:
    - type: Container
      defaultRequest:
        cpu: 10m
        memory: 16Mi
      default:
        cpu: 100m
        memory: 64Mi
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: namespace-limits
  namespace: status
spec:
  hard:
    limits.cpu: "500m"
    limits.memory: 256Mi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: hello-world-page
  namespace: status
data:
  index.html: |
    <!doctype html>
    <html lang="en">
      <head><meta charset="utf-8"><title>Status</title></head>
      <body><h1>OK</h1><p>The home server is up.</p></body>
    </html>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello-world
  namespace: status
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hello-world
  template:
    metadata:
      labels:
        app: hello-world
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: web
          image: {{ status_page_image }}
          ports:
            - containerPort: 8080
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          readinessProbe:
            httpGet:
              path: /
              port: 8080
          volumeMounts:
            - name: page
              mountPath: /usr/share/nginx/html
              readOnly: true
      volumes:
        - name: page
          configMap:
            name: hello-world-page
---
apiVersion: v1
kind: Service
metadata:
  name: hello-world
  namespace: status
spec:
  selector:
    app: hello-world
  ports:
    - port: 80
      targetPort: 8080
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hello-world
  namespace: status
spec:
  ingressClassName: traefik
  rules:
    - host: status.{{ secrets.domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: hello-world
                port:
                  number: 80
